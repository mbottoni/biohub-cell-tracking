# data & artifacts — never commit
# NOTE: anchored with a leading slash so it only matches the top-level data/ dir,
# not the src/ctrack/data/ package.
/data/*
!/data/.gitkeep
*.zarr/
*.tif
*.tiff
*.npy
*.npz
*.h5
*.zip
models/
checkpoints/
outputs/
submissions/
wandb/
lightning_logs/
mlruns/

# credentials
kaggle.json
.env
*.pem

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# os / editor
.DS_Store
.idea/
.vscode/

# large cached listing is fine to keep, raw data is not
!/data/filelist.json

# Kaggle kernel push writes this
kernel/kernel-metadata.json.bak

# Kaggle build artifacts
kaggle_assets/wheels/wheels/
kaggle_assets/ctrack_src/ctrack/
